{
	"name": "ttrpg-card-forge",
	"version": "0.2.0",
	"description": "Create printable TTRPG cards from structured Markdown content in your Obsidian vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --test tests/item-parser.test.ts tests/item-card-layout.test.ts",
		"lint": "eslint .",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"ttrpg",
		"cards"
	],
	"engines": {
		"node": ">=18.18.0"
	},
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
